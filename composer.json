{
	"name": "pourmirzai/gatewaykit",
	"description": "GatewayKit – Payment Gateway for Elementor Forms (Lite + Pro add-on). Freemius WordPress SDK is the only runtime Composer dependency and is shipped inside both plugin ZIPs (vendor/freemius/wordpress-sdk).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"freemius/wordpress-sdk": "^2.13",
		"dompdf/dompdf": "^2.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6.33",
		"squizlabs/php_codesniffer": "^3.13.5",
		"wp-coding-standards/wpcs": "^3.4.0"
	},
	"scripts": {
		"post-autoload-dump": [
			"php bin/patch-freemius-sdk.php"
		],
		"test": "phpunit",
		"test:keys": "phpunit --bootstrap tests/bootstrap-with-keys.php tests/Crypto/CryptoRoundTripTest.php",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"prefer-stable": true
}
