#. Plugin Name of the plugin
#: gatewaykit-pro.php
msgid "GatewayKit Pro – Payment Gateway for Elementor Forms"
msgstr "GatewayKit Pro – بوابة الدفع لنماذج Elementor"

#. Plugin URI of the plugin
#: gatewaykit-pro.php
msgid "https://pourmirzai.com/gatewaykit"
msgstr "https://pourmirzai.com/gatewaykit"

#. Description of the plugin
#: gatewaykit-pro.php
msgid "Add-on for GatewayKit. Unlocks advanced Pro features: discount codes, advanced transaction log, per-form redirects, partial payments, currency selector, outgoing webhooks, and white-label branding. All payment gateways (Stripe, Mollie, CoinGate, Coinify, PayPal, NOWPayments) are now included in the free GatewayKit."
msgstr "إضافة لـ GatewayKit. تفتح ميزات Pro المتقدمة: أكواد الخصم، سجل معاملات متقدم، عمليات إعادة توجيه لكل نموذج، مدفوعات جزئية، محدد عملة، خطافات ويب صادرة، وعلامة بيضاء. جميع بوابات الدفع (Stripe، Mollie، CoinGate، Coinify، PayPal، NOWPayments) مضمّنة الآن في GatewayKit المجاني."

#. Author of the plugin
#: gatewaykit-pro.php
msgid "Morteza Pourmirzai"
msgstr "Morteza Pourmirzai"

#. Author URI of the plugin
#: gatewaykit-pro.php
msgid "https://pourmirzai.com"
msgstr "https://pourmirzai.com"

